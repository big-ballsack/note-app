{
  "name": "note-application",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "bun run --cwd services/backend test",
    "test:integration": "bun run --cwd services/backend test:integration",
    "check": "biome check --write",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml down",
    "db:migrate": "bun run --cwd services/backend db:migrate"
  },
  "workspaces": {
    "packages": [
      "services/*",
      "shared/*"
    ],
    "catalog": {
      "better-auth": "1.7.17"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "turbo": "^2.11.10"
  }
}
