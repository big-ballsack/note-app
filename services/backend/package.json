{
  "name": "@note-application/backend",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "generate": "bun --bun --env-file=.env prisma generate",
    "db:migrate": "bun --bun --env-file=.env prisma migrate dev",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@note-application/types": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "catalog:",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prisma": "7.10.1",
    "typescript": "^7.0.2"
  }
}
