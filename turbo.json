{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "inputs": [
        "prisma/**"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "VITE_*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "generate"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "generate"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT"
      ]
    }
  }
}
